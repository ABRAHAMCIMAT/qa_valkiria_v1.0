# Plantilla única de configuración de Valkiria.
#   Local:  cp .env.example .env
#   Docker Compose: usa este mismo formato; compose sobrescribe las URLs internas entre contenedores.
# Solo datos sintéticos. Nunca coloques aquí URLs, usuarios ni llaves productivas.

# --- Modo y entorno (producción bloqueada por defecto) ---
VALKIRIA_MODE=synthetic
VALKIRIA_ENVIRONMENT=qa
VALKIRIA_ALLOW_PRODUCTION=false

# --- Base de datos sintética ---
VALKIRIA_DB_PROFILE=synthetic_postgresql
VALKIRIA_DB_ENGINE=postgresql
# Credenciales exclusivas del contenedor efímero local/CI (docker-compose.synthetic.yml).
# Si se deja vacía, la API usa SQLite en memoria como respaldo.
VALKIRIA_SYNTHETIC_DATABASE_URL=postgresql+psycopg://valkiria:valkiria_synthetic_only@localhost:5432/nissan_synthetic
VALKIRIA_SYNTHETIC_APP_BASE_URL=http://localhost:8090
# Persistencia de los flujos por historia (SQLite o PostgreSQL). Vacía: en memoria (se pierde al reiniciar).
# Ejemplo local: sqlite+pysqlite:///./valkiria-workflows.db
VALKIRIA_WORKFLOW_DATABASE_URL=

# --- Memoria del sistema multiagente ---
# Corta: hilo de cada sesión (chat u orquestador), ventana de turnos y expiración por inactividad.
# Larga: conocimiento validado por personas (HU aprobadas, preferencias del PO, correcciones, lecciones).
VALKIRIA_MEMORY_ENABLED=true
# Vacía: usa VALKIRIA_WORKFLOW_DATABASE_URL; si ambas están vacías, la memoria vive en el proceso.
VALKIRIA_MEMORY_DATABASE_URL=
VALKIRIA_MEMORY_SHORT_TERM_TURNS=12
VALKIRIA_MEMORY_SHORT_TERM_TTL_MINUTES=120
VALKIRIA_MEMORY_LONG_TERM_TOP_K=4
VALKIRIA_MEMORY_LONG_TERM_RETENTION_DAYS=365

# --- LLM compatible con OpenAI (Ollama local por defecto) ---
VALKIRIA_LLM_BASE_URL=http://localhost:11434/v1
VALKIRIA_LLM_MODEL=llama3.2:3b-instruct-q4_K_M
# Vacía para Ollama local. En otros entornos, inyectarla desde un gestor de secretos.
VALKIRIA_LLM_API_KEY=
# "authorization" (Bearer) para Ollama/vLLM/OpenAI; "api-key" para Azure OpenAI con llave.
# Azure OpenAI: VALKIRIA_LLM_BASE_URL=https://<recurso>.openai.azure.com/openai/v1 y VALKIRIA_LLM_MODEL=<nombre del deployment>.
VALKIRIA_LLM_AUTH_HEADER=authorization

# --- API ---
# Carpeta del frontend servido en "/". Vacía: usa frontend/ del repositorio.
VALKIRIA_FRONTEND_DIR=
# Orígenes CORS separados por comas.
VALKIRIA_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# --- Automatización (Playwright real solo con EXECUTE=true) ---
VALKIRIA_AUTOMATION_RUNNER=playwright
VALKIRIA_AUTOMATION_EXECUTE=false
VALKIRIA_AUTOMATION_HEADLESS=true
VALKIRIA_AUTOMATION_TIMEOUT_SECONDS=30

# --- Release: solo preview y Pull Request, nunca commit directo ---
VALKIRIA_RELEASE_MODE=preview
VALKIRIA_DIRECT_COMMIT=false
VALKIRIA_PR_REQUIRED=true
